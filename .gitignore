# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Research-bot response cache (regenerable; not source)
literature/.cache/

# Scratch / temp dumps
_*.txt
_*.json

# Fitted-model cache (runtime artefact, rebuilt on demand).
# The deployable artefact is the exception: a hosted service is built from this repository and
# must not carry the dataset, so the ~26 KB model (coefficients and metadata, no row-level data)
# is tracked deliberately. Rebuild with: python -m emerald_ai build-artefact
artefacts/*
!artefacts/scorer.joblib

# Regenerable dissertation build outputs (source is the *.md chapters + build.py)
docs/dissertation/dissertation.md
docs/dissertation/dissertation.docx

# Stray duplicate of the raw dataset (tracked copy lives at repo root)
data/All_Funded_2019_Green Loan.xlsx

# Local / agent working files (not dissertation deliverables)
CLAUDE.md
.claude/
*.local.md

# OS
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Never publish: the lender's data, the dissertation itself, and anything
# carrying the candidate's personal details. All of these live locally only.
# ---------------------------------------------------------------------------
All_Funded_2019_Green Loan.xlsx
*.xlsx
proposal_draft.docx
docs/dissertation/
docs/supervision_brief_*.md
~$*
